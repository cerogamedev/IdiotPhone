<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/win98_teal">

    <!-- Primary Desktop WebView -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/win98_teal"
        android:scrollbars="none" />

    <!-- In-App Retro Browser Overlay (for WhatsApp Web & Gmail without iframe restrictions) -->
    <LinearLayout
        android:id="@+id/retro_browser_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/win98_gray"
        android:visibility="gone">

        <!-- Win98 Retro Browser Titlebar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/titlebar_gradient"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/retro_browser_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Internet Explorer - Web"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/retro_browser_back"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:text="⟵"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:background="@drawable/win98_btn_bg" />

            <Button
                android:id="@+id/retro_browser_refresh"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:text="↻"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:background="@drawable/win98_btn_bg" />

            <Button
                android:id="@+id/retro_browser_close"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:text="✕"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:background="@drawable/win98_btn_bg" />

        </LinearLayout>

        <!-- Browser WebView -->
        <WebView
            android:id="@+id/retro_browser_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white" />

    </LinearLayout>

</FrameLayout>
